# 环境变量与密钥
.env
.env.*
!.env.example
server/.env

# SQLite 数据库文件（本机数据，不入库）
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*
# 朋友圈配图（用户数据，不入库）
data/uploads/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/

# 临时文件
.DS_Store
*.log

# 本地临时运行文件
.tmp/

# 截图不入库
shots/

# 历史 dist 备份不入库（只保留 dist/index.html）
dist/index.*.html
dist/*.prev.html

# 本地运行标记
.done
.done.*
.exit
.exit.*
.coverage
htmlcov/
coverage.xml
*.bak-*

# 参考资料（含第三方禁止二传的主题与截图，不能随仓库分发）
ref/
effort-high.patch.yml
