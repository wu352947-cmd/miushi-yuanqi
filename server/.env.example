# 复制成 .env 后按需填写；.env 不会进 git。
# 所有变量都可以用环境变量直接给，不一定要 .env 文件。

# 必填：用来加密 API Key、签名登录会话。
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# 可选：设置了就要求登录（单账号）。留空 = 开发模式免登录，
# 页面与日志会明确提示「未设置登录密码」。不要在有他人访问的机器上留空。
APP_PASSWORD=

# 监听地址与端口。默认只监听本机 127.0.0.1；只有明确要从手机 / 局域网访问时
# 才改成 0.0.0.0，并自行确认防火墙与网络环境可信。
HOST=127.0.0.1
PORT=8080

# 可选
# APP_USER_NAME=owner
# MSYQ_DATA_DIR=./data
# MSYQ_DB_PATH=./data/miushi.db
# CURRENCY_USD_CNY=7.1
# SESSION_SECURE=1
# MSYQ_MOCK=1          # 仅本地演示 / 测试：不请求外部接口，回复由本机生成
# MSYQ_MOCK_400=1      # 配合 MSYQ_MOCK，演示思考参数 400 兜底
# MSYQ_SEED=0          # 关闭首次启动的演示数据
